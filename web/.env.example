# ── Orrery Web Console — build/runtime configuration ─────────────────
# Copy to `.env.local` for local development. All client-exposed vars MUST be
# prefixed `VITE_` (Vite only inlines those into the bundle).

# Base URL of the FastAPI front door. Leave empty for same-origin (the default,
# and how it runs in production where FastAPI serves the bundle itself).
# Set to a full URL (e.g. http://localhost:8000) only for cross-origin dev.
VITE_API_BASE_URL=

# Dev-only: where `vite dev` proxies /chat during local development.
# Not inlined into the bundle; read by vite.config.ts at dev time.
VITE_DEV_API_TARGET=http://localhost:8000
